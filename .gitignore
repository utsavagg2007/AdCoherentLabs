# Secrets — the single consolidated backend+engine env. NEVER commit.
# (frontend/.env.local is ignored by frontend/.gitignore.)
.env
.env.*

# ...except the committed template a new developer copies to .env. Without
# this negation `.env.*` above swallows it and a fresh clone has nothing to
# fill in. It holds placeholders only — see the header in the file.
!.env.example

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.venv/
venv/

# OS / editor
.DS_Store
Thumbs.db
