# ---- backend/.env.example (Appendix A) — values live in per-environment
# secret stores; never committed. Generate the real file with
#   python backend/scripts/gen_env.py     (AFTER python supabase/harden.py — P0)

APP_ENV=dev                       # dev | staging | prod (prod refuses default secrets)

# Data plane
SUPABASE_URL=                     # Kong URL
SUPABASE_SERVICE_ROLE_KEY=        # SERVER ONLY - storage/admin API calls
SUPABASE_JWT_SECRET=              # HS256 verify (rotated by harden.py)
POSTGRES_PASSWORD=                # compose interpolation for in-network DB URLs
SUPABASE_DB_URL=                  # privileged Postgres role for engine.saas (bypasses RLS)
DATABASE_URL_API=                 # dev: socat :54322 · prod: pooler :6543 (transaction mode)
DATABASE_URL_WORKER=              # dev: socat :54322 · prod: pooler :5432 (session mode)
DATABASE_URL_MIGRATIONS=          # socat :54322 direct (apply.sh / DDL only)

# App
API_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
REDIS_PASSWORD=
REDIS_URL=redis://:password@redis:6379/0
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_REQUIRED=true              # fail-closed uploads when clamd is down
RATE_LIMIT_FAIL_MODE=degraded     # §9.4
MAX_BODY_MB=60                    # edge cap; per-tier caps come from plan_entitlements
ADMIN_EMAILS=                     # /v1/admin staff allowlist, comma-separated
RETENTION_DRY_RUN=true            # flip to false after the P9 dry-run gate

# Workers
WORKER_ID_PREFIX=wk
LEASE_SECONDS=300
HEARTBEAT_SECONDS=30
RUN_MAX_SECONDS=1800
PROVIDER_MAX_PARALLEL_ANTHROPIC=4
PROVIDER_MAX_PARALLEL_OPENROUTER=8
STOP_GRACE_SECONDS=120

# Providers (server only; pinned models resolve from plan_entitlements / engine tiers)
ANTHROPIC_API_KEY=                # pro / design / enterprise
OPENROUTER_API_KEY=               # free / hobby (Qwen via OpenRouter)
EGRESS_PROXY_URL=                 # SSRF allowlist proxy (URL-ingestion phase B)

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_HOBBY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_DESIGN=
STRIPE_PRICE_ENTERPRISE=
STRIPE_PRICE_PACK_STARTER=
STRIPE_PRICE_PACK_GROWTH=
STRIPE_PRICE_PACK_SCALE=

# Ops
SENTRY_DSN=
LOG_LEVEL=info
METRICS_BASIC_AUTH=               # "user:pass"; empty = proxy-blocked internal only
