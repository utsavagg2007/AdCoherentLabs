# Upload filter for `gcloud run deploy --source`. Without it gcloud ships the
# whole working tree to Cloud Build, including .git, both node_modules trees,
# the 71 MB corpus dump and the 126 MB snapshot directory.
#
# NOTE: gcloud honours .gitignore by default; this file REPLACES that behaviour
# once present. It therefore has to re-state the secret exclusions itself —
# otherwise .env would be uploaded to Cloud Build and baked into the image.

.git
.gitignore
.github
.claude
.agents

# --- SECRETS: injected by Cloud Run at run time, never built in --------------
.env
.env.*
frontend/.env*

# --- dependency trees (reinstalled inside the image) ------------------------
.venv
**/.venv
venv
node_modules
**/node_modules

# --- build noise -------------------------------------------------------------
__pycache__
**/__pycache__
*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
frontend/.next
frontend/out

# --- large data not needed at run time ---------------------------------------
rag_corpus.sql
rag-engine/data/raw
rag-engine/data/manual
*.pdf
*.png
*.jpeg
*.jpg
report.json
report-*.json
*.bak
