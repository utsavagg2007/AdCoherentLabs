# AdCoherentLabs runtime configuration — copy to .env and edit.
# The FREE tier needs NEITHER of these: with no .env at all, the
# pipeline runs on local OCR (PaddleOCR/pytesseract) exactly as before.

# OCR provider tier: "free" (local OCR, default) or "paid" (Google
# Cloud Vision — better OCR + semantic signals; falls back to free on
# any failure, including missing credentials).
OCR_TIER=free

# Path to a Google Cloud service-account JSON key file. Only read when
# OCR_TIER=paid. If unset/unreadable (or google-cloud-vision is not
# installed), the pipeline logs one clear warning at startup and keeps
# running on the free tier — it never crashes on missing config.
#GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
