# =============================================================================
# .env.example — TEMPLATE for the single backend + engine env file.
#
#   cp .env.example .env      # then fill every __PLACEHOLDER__ below
#
# This is the ONLY env file the backend, the worker, the scheduler and all four
# engine layers read (loaded by backend/app/config.py and engine/_paths.py).
# The frontend has its own: frontend/.env.local (see .env.local.example there).
#
# SAFE TO COMMIT — placeholders only. The real .env is gitignored; never commit
# it and never paste real values into this file.
#
# The placeholders are load-bearing: backend/app/config.py::require_boot_secrets
# and backend/docker-entrypoint.sh both refuse to start while `PROJECT_ID`
# or `__PASTE_` survives anywhere in the data-plane URLs. A half-filled file
# fails at boot instead of silently pointing at the wrong database.
#
# Values come from the Supabase dashboard for the SHARED CLOUD project:
#   Project Settings -> API      -> Project URL, service_role key
#   Project Settings -> API Keys -> JWT secret (legacy HS256)
#   Project Settings -> Database -> Connection string -> *Session pooler*
# Ask the project owner for the DB password; it is not in the dashboard.
# =============================================================================

APP_ENV=dev                     # dev | staging | prod
LOG_LEVEL=info

# -- data plane (Supabase Cloud) ----------------------------------------------
# cloud = talk to Supabase over TLS. Do NOT set this to `local` unless you are
# actually running the self-hosted stack; cloud mode is what lets you work from
# a clone with no database of your own.
SUPABASE_MODE=cloud
SUPABASE_URL=https://PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The PUBLIC anon/publishable key. No backend code reads this — it is here so
# `docker compose build frontend` can pass it as a build arg (build args cannot
# come from an env_file, and NEXT_PUBLIC_* values are compiled into the bundle).
# Safe to have alongside secrets: row-level security is what constrains it.
# Do NOT put the service_role key here; it bypasses RLS entirely.
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ISSUER=https://PROJECT_ID.supabase.co/auth/v1

# Use the SESSION pooler (port 5432), never the transaction pooler (6543):
# psycopg3 promotes hot statements to server-side prepared statements after 5
# executions, and PgBouncer in transaction mode drops those between
# transactions — the failure is intermittent and only appears under load.
# pgvector's register_vector() likewise needs stable per-connection types.
# URL-encode the password if it contains @ / # ? or %.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_ID:DB_PASSWORD@aws-0-us-west-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.PROJECT_ID:DB_PASSWORD@aws-0-us-west-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL_API=postgresql://postgres.PROJECT_ID:DB_PASSWORD@aws-0-us-west-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL_WORKER=postgresql://postgres.PROJECT_ID:DB_PASSWORD@aws-0-us-west-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL_MIGRATIONS=postgresql://postgres.PROJECT_ID:DB_PASSWORD@aws-0-us-west-1.pooler.supabase.com:5432/postgres?sslmode=require

# -- frontend build args (NEXT_PUBLIC_*, compiled into the browser bundle) ---
# docker-compose.yml reads these when building the frontend image. They are
# BUILD inputs: changing one needs `docker compose build frontend`, never a
# restart. Only ever PUBLIC values here — build args are readable by every
# visitor and are recorded in the image's layer history.
#
# The origin Supabase returns the browser to after a social provider approves.
# `<this>/auth/callback` must be allowlisted in Supabase under
# Authentication -> URL Configuration -> Redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Which social buttons to show: google, facebook, slack (comma separated).
# An empty value turns social sign-in off.
NEXT_PUBLIC_AUTH_PROVIDERS=google,facebook,slack

# -- production deploy (single VM) -------------------------------------------
# Read ONLY by docker-compose.prod.yml, which hands it to Caddy. A bare
# hostname: no scheme, no path, no trailing slash. Caddy requests a TLS
# certificate for exactly this name, so a typo here is a box that serves
# nothing but ACME failures. Leave it empty for local work - only the prod
# overlay requires it. See DEPLOY.md.
SITE_DOMAIN=

# -- social sign-in (Google / Facebook / Slack) ------------------------------
# WHERE THESE ACTUALLY TAKE EFFECT — read this before filling anything in.
#
# This project runs Supabase CLOUD, and cloud GoTrue does NOT read provider
# credentials from any file in this repo. The client id and secret must be
# pasted into the Supabase dashboard:
#
#   Authentication -> Sign In / Providers -> {Google | Facebook | Slack (OIDC)}
#
# They are recorded here so the values live in one place alongside the rest of
# the project's configuration, and because the SELF-HOSTED stack does consume
# them: copy each pair into that stack's own .env and uncomment the matching
# GOTRUE_EXTERNAL_* lines in its docker-compose.yml.
#
# NEVER copy a secret into frontend/.env.local. Every NEXT_PUBLIC_* value is
# compiled into the JavaScript bundle and served to every visitor.
#
# ---- callback URL to register with each provider ----------------------------
# All three providers get the SAME redirect URI — Supabase's, not the app's:
#
#   https://PROJECT_ID.supabase.co/auth/v1/callback
#
# ---- redirect URLs to allowlist in Supabase ---------------------------------
# Authentication -> URL Configuration -> Redirect URLs. Supabase refuses any
# return address not on this list, which is the usual cause of a login that
# completes at the provider and then dead-ends:
#
#   http://localhost:3000/auth/callback      (local dev)
#   https://<your-domain>/auth/callback      (production)
#
# Set Site URL on that same page to the production origin.

# Google — console.cloud.google.com -> APIs & Services -> Credentials
#   Create an "OAuth client ID" of type "Web application".
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# Facebook — developers.facebook.com -> your app -> Facebook Login -> Settings
#   The app must be LIVE (not "In development") before anyone outside the
#   app's own testers can sign in, and `email` must be an approved permission
#   or the account arrives with no address and cannot be granted access.
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=

# Slack — api.slack.com/apps -> your app -> OAuth & Permissions
#   Use "Sign in with Slack" (OpenID Connect) with the openid, email and
#   profile scopes. In Supabase this is the provider named "Slack (OIDC)";
#   the older plain "Slack" provider is deprecated and rejects new apps.
OAUTH_SLACK_CLIENT_ID=
OAUTH_SLACK_CLIENT_SECRET=

# -- LLM providers (server only, never exposed to the browser) ----------------
# free/hobby tiers route to OpenRouter; pro/design/enterprise to Anthropic.
# Leave blank to develop against `--stub-llm`, which exercises the whole
# pipeline without spending provider credit.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Model overrides; defaults live in rag-engine/adcoherent_rag/review/tiers.py
# OPENROUTER_FREE_MODEL=qwen/qwen3.7-plus
# OPENROUTER_HOBBY_MODEL=qwen/qwen3.7-max

# -- engine: OCR (Layer 1) + embeddings (Layer 3) -----------------------------
OCR_TIER=free
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# -- app ----------------------------------------------------------------------
# Exact origins, comma-separated. No wildcard — CORS runs with credentials.
# Add your deployed frontend origin here when you go live.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Swagger at /docs and ReDoc at /redoc. Defaults to TRUE in code, so a
# production box has to turn them off explicitly. /v1/openapi.json is served
# either way.
DOCS_ENABLED=true

# Generate your own; it is local to your compose stack, not a shared secret:
#   python -c "import secrets; print(secrets.token_hex(16))"
# REDIS_URL must contain the same password. Inside compose the entrypoint
# rewrites the host to the `redis` service; this value is for host-side runs.
REDIS_PASSWORD=HEX_16_STRING
REDIS_URL=redis://:HEX_16_STRING@127.0.0.1:6379/0

# 127.0.0.1, not localhost: Docker publishes on loopback IPv4 and Windows
# resolves localhost to ::1 first, burning a connect timeout on every call.
# The container entrypoint overrides this with the `clamav` service name.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_REQUIRED=true            # uploads fail closed when the scanner is down

ADMIN_EMAILS=                   # comma-separated staff allowlist for /v1/admin
RETENTION_DRY_RUN=true          # keep true until the retention job is verified

# -- billing (optional in dev) -------------------------------------------------
# With STRIPE_SECRET_KEY empty and APP_ENV != prod, checkout is simulated
# in-process by backend/app/services/dev_billing.py — plan and credit-pack
# purchases apply directly and are audited with simulated=true.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_HOBBY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_DESIGN=
STRIPE_PRICE_ENTERPRISE=
STRIPE_PRICE_PACK_STARTER=
STRIPE_PRICE_PACK_GROWTH=
STRIPE_PRICE_PACK_SCALE=

# -- ops -----------------------------------------------------------------------
SENTRY_DSN=
METRICS_BASIC_AUTH=             # "user:pass"; empty = /metrics is internal only
