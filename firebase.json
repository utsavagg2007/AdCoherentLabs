{
  "hosting": {
    "public": "frontend/public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/v1/**",
        "run": { "serviceId": "adcoherent-api", "region": "__CLOUD_RUN_REGION__" }
      },
      {
        "source": "/healthz",
        "run": { "serviceId": "adcoherent-api", "region": "__CLOUD_RUN_REGION__" }
      },
      {
        "source": "/readyz",
        "run": { "serviceId": "adcoherent-api", "region": "__CLOUD_RUN_REGION__" }
      },
      {
        "source": "**",
        "run": { "serviceId": "adcoherent-frontend", "region": "__CLOUD_RUN_REGION__" }
      }
    ],
    "headers": [
      {
        "source": "/_next/static/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "/v1/**",
        "headers": [{ "key": "Cache-Control", "value": "no-store" }]
      }
    ]
  }
}
