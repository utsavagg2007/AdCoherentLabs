# Supabase Postgres connection string (direct connection recommended for DDL).
# Self-hosted docker stack (supavisor pooler broken there): run the socat proxy
#   docker run -d --name adcoherent-rag-db-proxy --restart unless-stopped \
#     --network supabase_default -p 127.0.0.1:54322:5432 \
#     alpine/socat tcp-listen:5432,fork,reuseaddr tcp-connect:supabase-db:5432
# then: postgresql://postgres:<POSTGRES_PASSWORD>@127.0.0.1:54322/postgres
# Supabase Cloud: use the "Direct connection" string from Project Settings > Database.
DATABASE_URL=postgresql://postgres:your-super-secret-and-long-postgres-password@localhost:54322/postgres

# Embedding model (local, via sentence-transformers). 384-dim.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Dev/test only: deterministic hash-based vectors, no model download.
# EMBEDDING_FAKE=1

# Optional overrides
# MANIFEST_PATH=/absolute/path/to/adcoherent_regulatory_sources.json
# RAW_STORAGE_DIR=/absolute/path/to/raw/snapshots

# HTTP tuning for verification sweeps (fail fast on geo-blocked state hosts)
# HTTP_CONNECT_TIMEOUT=12
# HTTP_TIMEOUT=45
# HTTP_RETRIES=1

# --- LLM review layer (python -m adcoherent_rag.cli review ...) ---
# Claude tiers (pro / design / enterprise)
ANTHROPIC_API_KEY=
# Free / hobby tiers — Qwen models via OpenRouter (OpenAI-compatible API)
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_FREE_MODEL=qwen/qwen3.7-plus
# OPENROUTER_HOBBY_MODEL=qwen/qwen3.7-max
# Optional attribution headers (OpenRouter app rankings):
# OPENROUTER_SITE_URL=https://adcoherentlabs.com
# OPENROUTER_APP_NAME=AdCoherentLabs
