# =============================================================================
# frontend/.env.local.example — TEMPLATE for the Next.js env file.
#
#   cp .env.local.example .env.local     # then fill the placeholders
#
# SAFE TO COMMIT — placeholders only. The real .env.local is gitignored.
#
# PUBLIC values only. Every NEXT_PUBLIC_* var is inlined into the JavaScript
# bundle at build time and is readable by anyone who loads the page. Never put
# the service_role key, the JWT secret or a database password here — use the
# anon / publishable key, which is designed to be public and is constrained by
# row-level security.
#
# Both Supabase values: dashboard -> Project Settings -> API.
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://__PROJECT_REF__.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=__PASTE_ANON_KEY__

# The FastAPI backend.
#   local (host `npm run dev`)      http://127.0.0.1:8080
#   local (full docker compose up)  http://127.0.0.1:8080
#   deployed                        https://your-domain.com  (same origin via Caddy)
#
# 127.0.0.1 rather than localhost is deliberate on Windows: localhost resolves
# to ::1 first and the request burns a timeout before falling back to IPv4.
#
# Read at BUILD time, not run time — changing it means rebuilding the frontend
# image, not just restarting the container.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080

# -- social sign-in ----------------------------------------------------------
# PUBLIC values only. The Google / Facebook / Slack client SECRETS do NOT go
# here and do not belong in any NEXT_PUBLIC_* variable — this file is compiled
# into the browser bundle. They live in the Supabase dashboard
# (Authentication -> Sign In / Providers); see the root .env for the full
# setup notes and the callback URLs.

# Where Supabase sends the browser back to after a provider approves. The app
# appends /auth/callback, and that exact URL must be allowlisted under
# Authentication -> URL Configuration -> Redirect URLs in Supabase.
#
# Unset falls back to window.location.origin, which is right for local dev and
# WRONG behind a proxy or on a preview deployment, where the browser's origin
# is not the origin registered with the provider. Set it explicitly in
# production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Which buttons to show, comma separated: google, facebook, slack.
# A button for a provider that is not enabled in Supabase is a dead end, so
# trim this to what you have actually configured. Unset = all three.
# Empty (NEXT_PUBLIC_AUTH_PROVIDERS=) turns social sign-in off entirely.
NEXT_PUBLIC_AUTH_PROVIDERS=google,facebook,slack
